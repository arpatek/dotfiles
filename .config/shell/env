# ┌──────────────────────────────────────────────────────────────┐
# │ arpatek - Shared Shell Environment                           │
# │ Sourced by both shells before their aliases. Anything here   │
# │ must be POSIX — no zsh or bash syntax.                       │
# └──────────────────────────────────────────────────────────────┘

# ──[ umask ]───────────────────────────────────────────────────────────────────
# 027: owner full, group read, world nothing. The default 022 makes every file
# you create world-readable, which on a shared or service-running box means
# anything you drop in /tmp or a project directory is readable by every account.
#
# 027 rather than 077 deliberately — 077 denies the group too, which breaks the
# common case of a file meant for a service account in a shared group. Tighten to
# 077 if no box here ever needs group access.
umask 027

# ──[ Pager and Man ]───────────────────────────────────────────────────────────
export LESS='-R'
export MANROFFOPT='-c'
# bat renders man pages with syntax highlighting — no LESS_TERMCAP_* needed. It
# does not understand groff's backspace overstrike (X\bX is how bold is encoded)
# and prints the ^H literally, so col strips it before bat sees it. On groff hosts
# grotty emits SGR escapes rather than overstrike, which col does not touch — -c
# forces the legacy format so there is something for col to strip.
# Guarded: without bat this would break `man` entirely.
if command -v bat >/dev/null 2>&1; then
    export MANPAGER="sh -c 'col -bx | bat -l man -p'"
fi

# ──[ GPG ]─────────────────────────────────────────────────────────────────────
# gpg needs to know which terminal to prompt on, or signing fails in a way that
# looks like a key problem.
GPG_TTY=$(tty)
export GPG_TTY
