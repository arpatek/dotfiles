# ┌──────────────────────────────────────────────────────────────┐
# │ arpatek - Shared OS Delta, Linux                             │
# │ Sourced by both shells. Shell-specific Linux bits live in     │
# │ .config/zsh/os.d/linux.zsh — bash needs none.                 │
# └──────────────────────────────────────────────────────────────┘

export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border=rounded'

alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias ip='ip --color=auto'
alias shutdown='sudo shutdown now'

# ──[ Prompt Selection ]────────────────────────────────────────────────────────
# Exported here rather than in each shell's rc so both pick it up, and only on
# Linux because starship-sysadmin.toml is only linked there. The file check
# matters: a host provisioned before this config existed will not have it, and
# starship fails loudly on a missing STARSHIP_CONFIG rather than falling back.
# id -un rather than $USER — the variable is routinely unset in containers.
if [ "${USER:-$(id -un)}" = "sysadmin" ] &&
    [ -r "${XDG_CONFIG_HOME:-$HOME/.config}/starship-sysadmin.toml" ]; then
    export STARSHIP_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/starship-sysadmin.toml"
fi
