# ┌──────────────────────────────────────────────────────────────┐
# │ arpatek - Bash Aliases                                       │
# │ Only what cannot be shared. Everything portable lives in      │
# │ .config/shell/aliases.                                        │
# └──────────────────────────────────────────────────────────────┘

# ──[ Shell Config ]────────────────────────────────────────────────────────────
# Named for the shell rather than 'bashconfig', so the same word works in
# either shell and muscle memory transfers.
alias shellconfig='${EDITOR:-vi} ~/.config/bash/bashrc'
alias aliases='${EDITOR:-vi} ~/.config/shell/aliases'

# exec bash, not exec $SHELL: chsh may say zsh while this session is bash, and
# reload should reload the shell you are in, not switch you to another one.
alias reload='exec bash'
