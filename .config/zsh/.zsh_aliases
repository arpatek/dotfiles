# ┌──────────────────────────────────────────────────────────────┐
# │ arpatek - Zsh Aliases                                        │
# │ Only what cannot be shared. Everything portable lives in     │
# │ .config/shell/aliases. OS-specific ones in os.d/.            │
# └──────────────────────────────────────────────────────────────┘

# ──[ Shell Config ]────────────────────────────────────────────────────────────
# shellconfig is the name bash uses too, so the word works in either shell.
# zshconfig stays for muscle memory.
alias shellconfig='${EDITOR:-vi} ~/.config/zsh/.zshrc'
alias zshconfig='${EDITOR:-vi} ~/.config/zsh/.zshrc'
alias aliases='${EDITOR:-vi} ~/.config/shell/aliases'

# exec zsh, not exec $SHELL: reload should reload the shell you are in, not
# switch you to whatever chsh happens to say.
alias reload='exec zsh'
