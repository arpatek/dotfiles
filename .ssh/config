# ┌──────────────────────┐
# │ arpatek - SSH Config │
# └──────────────────────┘

# ──[ Portal-22 ]───────────────────────────────────────────────────────────────
Include ~/.ssh/config.local
# ──[ /Portal-22 ]──────────────────────────────────────────────────────────────


# ──[ Global Defaults ]─────────────────────────────────────────────────────────
# These apply to every host unless overridden in a specific Host block.

Host *
  # Connection multiplexing: reuse an existing TCP connection to the same host.
  # The first ssh opens a master socket; every subsequent ssh to that host
  # tunnels through it — near-instant reconnects and no repeated key prompts.
  ControlMaster auto
  ControlPath   ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m

  # Send a keepalive packet every 60s so the connection doesn't drop behind
  # an idle-timing NAT gateway or firewall.
  ServerAliveInterval 60
  ServerAliveCountMax 3

  # Load new keys into the running ssh-agent automatically on first use.
  AddKeysToAgent yes

  # ──[ Hardening ]─────────────────────────────────────────────────────────────
  # Offer only the key this host is configured for. Without it ssh offers every
  # identity in the agent to every host it touches — currently 15 keys — so one
  # malicious or compromised server learns the whole fleet by name. Every Host
  # block in config.local already sets IdentityFile, so this costs nothing
  # there, and the IdentityFile below supplies this machine's own key as the
  # fallback — IdentityFile accumulates rather than first-wins, so an unlisted
  # host is offered exactly that one key instead of all fifteen. For a host that
  # needs a different key and has no entry yet, pass -i.
  IdentitiesOnly yes

  # The default identity for this machine, which is what IdentitiesOnly leaves a
  # host without a config.local entry. %L is the short local hostname, matching
  # portal-22's naming for a --glob key, so this resolves to darwin.key here and
  # <host>.key anywhere else. ssh skips a missing identity file silently, so on a
  # machine with no global key this costs nothing.
  IdentityFile ~/.ssh/%L.key

  # Store hostnames and addresses in known_hosts as hashes. A leaked or
  # backed-up known_hosts then does not enumerate the infrastructure.
  # `ssh-keygen -R host` still works; hand-editing the file does not.
  HashKnownHosts yes

  # ask, not accept-new: homelab VMs get rebuilt, and a changed host key is
  # exactly the event worth stopping for rather than silently trusting.
  StrictHostKeyChecking ask

  # Let the server rotate its host keys without tripping the warning above.
  UpdateHostKeys yes

  # Both default to no, set explicitly because the cost of being wrong is high.
  # Agent forwarding lets the remote end use every key in your agent for as long
  # as the session lives — root on that box can hijack the socket. Use ProxyJump
  # instead; the templates below show it.
  ForwardAgent no
  ForwardX11 no
  ForwardX11Trusted no

  # Log which key and host key fingerprint were used. Turns "did I connect with
  # the right identity" into something answerable after the fact.
  LogLevel VERBOSE

  # No Ciphers, MACs or KexAlgorithms lists here on purpose. OpenSSH 9.x
  # defaults already exclude everything worth excluding, and a pinned list is a
  # thing that silently rots — it would still be refusing SHA-1 long after that
  # stopped being the interesting question, while blocking whatever replaced it.


# ──[ Template Reference ]──────────────────────────────────────────────────────
# Copy a block below and fill in the brackets. These are not active entries.

# — Basic host —
# Host [alias]
#   HostName [ip-or-fqdn]
#   User [username]
#   IdentityFile ~/.ssh/[key-name]
#   IdentitiesOnly yes

# — Bastion / ProxyJump —
# Reach an internal host by routing through a public-facing jump server.
# SSH opens a connection to [bastion] first, then tunnels to [target] through it.
# Host [internal-alias]
#   HostName [internal-ip]
#   User [username]
#   IdentityFile ~/.ssh/[key-name]
#   IdentitiesOnly yes
#   ProxyJump [bastion-alias]

# — Port Forwarding (local) —
# Bind a local port and forward traffic to a remote host:port via the SSH server.
# Useful for reaching a database or web UI that is only exposed on the server's
# loopback interface (e.g. localhost:5432 on the remote).
# Host [alias]
#   HostName [ip-or-fqdn]
#   User [username]
#   IdentityFile ~/.ssh/[key-name]
#   LocalForward [local-port] [remote-host]:[remote-port]

# — Port Forwarding (remote) —
# Bind a port on the *remote* server and forward traffic back to a local host:port.
# Useful for exposing a local dev server to a remote host temporarily.
# Host [alias]
#   HostName [ip-or-fqdn]
#   User [username]
#   IdentityFile ~/.ssh/[key-name]
#   RemoteForward [remote-port] localhost:[local-port]

# — SOCKS Proxy —
# Turn the SSH connection into a SOCKS5 proxy on a local port.
# Point a browser or tool at socks5://localhost:[local-port] to route traffic
# through the remote server's network.
# Host [alias]
#   HostName [ip-or-fqdn]
#   User [username]
#   IdentityFile ~/.ssh/[key-name]
#   DynamicForward [local-port]
